<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:Crm.Muai.ViewModels"
             xmlns:models="clr-namespace:Crm.Muai.Models"
             x:Class="Crm.Muai.Views.CustomerDetailPage"
             Title="Informacion Del Cliente">
    <ContentPage.BindingContext>
        <viewmodels:CustomerDetailViewModel/>
    </ContentPage.BindingContext>
    <VerticalStackLayout
        Padding="16">
        <Label
            Text="Id:"/>
        <Label
            Text="{Binding Path=Customer.Id}"
            Margin="0,0,0,10"
            Padding="0,6,0,6"
            TextColor="DarkBlue"
            FontAttributes="Bold"
            BackgroundColor="WhiteSmoke"/>
        <Label
            Text="Nombre:"/>
        <Label
            Text="{Binding Path=Customer.FirstName}"
            Margin="0,0,0,10"
            Padding="0,6,0,6"
            TextColor="DarkBlue"
            FontAttributes="Bold"
            BackgroundColor="WhiteSmoke"/>
        <Label
            Text="{Binding Path=Customer.LastName}"/>
        <Label
            Text="Parker"
            Margin="0,0,0,10"
            Padding="0,6,0,6"
            TextColor="DarkBlue"
            FontAttributes="Bold"
            BackgroundColor="WhiteSmoke"/>
        <Label
            Text="{Binding Path=Customer.Email}"/>
        <Label
            Text="peter.parker@mail.com"
            Margin="0,0,0,10"
            Padding="0,6,0,6"
            TextColor="DarkBlue"
            FontAttributes="Bold"
            BackgroundColor="WhiteSmoke"/>  
    </VerticalStackLayout>
</ContentPage>