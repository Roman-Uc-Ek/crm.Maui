<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodel="clr-namespace:Crm.Muai.ViewModels"
             x:Class="Crm.Muai.Views.CustomerEditPage"
             Title="Nuevo Contacto">
    
    <ContentPage.BindingContext>
        <viewmodel:CustumerEditViewModel/>
    </ContentPage.BindingContext>
    <Grid
        Padding="8"
        >
        <VerticalStackLayout
            VerticalOptions="Start">
            <Label 
                Text="Nombre del contacto"/>
            <Entry
                Text="{Binding Path=Cust.FirstName}"
                Placeholder="P.Ej., John"
                Margin="0,0,0,16"
                BackgroundColor="WhiteSmoke"
                TextColor="Black"/>
            <Label 
                Text="Apellidos del contacto"/>
            <Entry
                Text="{Binding Path=Cust.LastName}"
                Placeholder="P.Ej., Doe"
                Margin="0,0,0,16"
                BackgroundColor="WhiteSmoke"
                TextColor="Black"/>
            <Label 
                Text="Correo electronico del contacto"/>
            <Entry
                Text="{Binding Path=Cust.Email}"
                Placeholder="P.Ej., jdoe@example.com"
                Margin="0,0,0,32"
                BackgroundColor="WhiteSmoke"
                TextColor="Black"/>
            <Button
                Text="Guardar"
                Command="{Binding Path=SaveCommand}"
                BackgroundColor="DarkCyan"/>
        </VerticalStackLayout>
        
    </Grid>
</ContentPage>