<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:Crm.Muai.ViewModels"
             xmlns:models="clr-namespace:Crm.Muai.Models"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="Crm.Muai.View.MainPage"
             Title="CRM"
             x:Name="Page">
    <ContentPage.BindingContext>
        <viewmodels:MainViewModels/>
    </ContentPage.BindingContext>

    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior
            EventName="Appearing"
            Command="{Binding Path=ShowinfCommand}"
            BindingContext="{Binding Source={x:Reference Page}, Path=BindingContext}"
            />
    </ContentPage.Behaviors>
    <Grid
        Padding="4">
        <RefreshView
            IsRefreshing="{Binding Path=Refreshing}"
            Command="{Binding Path=LoadCustomersCommand}">
            <CollectionView
                ItemsSource="{Binding Path=Custumers}"
                EmptyView="Aun no se han registrado clientes"
               >
                <CollectionView.ItemTemplate>
                    <DataTemplate
                        x:DataType="{x:Type models:Customer}">
                        <Grid
                            RowDefinitions="Auto, Auto"
                            Padding="10">
                            <Label
                                Grid.Row="0"
                                Text="{Binding Path=FullName}"/>
                            <Label
                                Grid.Row="1"
                                Text="{Binding Path=Email}"
                                TextColor="DarkGray"/>

                        </Grid>
                        
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                
            </CollectionView>
        </RefreshView>
        <Button
            Text="+"
            Command="{Binding Path=ShowNewCustomerForCommand}"
            WidthRequest="56"
            HeightRequest="56"
            FontSize="24"
            HorizontalOptions="End"
            VerticalOptions="End"
            Margin="16"
            BackgroundColor="DarkCyan"/>
    </Grid>
</ContentPage>